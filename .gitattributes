#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

src/main/generated/**/.cache/cache text eol=lf
src/main/generated/**/*.json text eol=lf
src/main/generated/** linguist-generated=true
src/main/resources/resourcepacks/poopsky_pack/assets/** linguist-generated=true
*.java text eol=lf charset=utf-8


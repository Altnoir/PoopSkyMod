    "BlockBehaviourMixin$BlockStateBaseMixin",
    "BlockEntityMixin",
    "BlockMixin",
    "BlockStateMixin",
    "DispenseItemBehaviorMixin",
    "EntityMixin",
    "FireBlockMixin",
    "ItemMixin",
    "ItemStackMixin",
    "LevelChunkMixin",
    "LiquidBlockMixin",
    "LivingEntityMixin",
    "MinecraftServerMixin",
    "MobMixin",
    "ServerLevelMixin",
